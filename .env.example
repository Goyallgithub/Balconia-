# Hard caps — keep low while using a personal OpenAI key
# Per-user AI cap. Set to 0 for unlimited local testing; use 2 before go-live.
MAX_GENERATIONS_PER_USER=2
# Global OpenAI spend safety net. 0 = unlimited (local only).
OPENAI_IMAGE_MAX_GENERATIONS=2
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1536

